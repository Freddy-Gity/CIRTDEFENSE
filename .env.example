# ---------------------------------------------------------------------------
# CIRTDEFENSE - configuration d'execution (copier en .env)
# ---------------------------------------------------------------------------

# Identite du deploiement
CIRT_ENV=dev
CIRT_SITE_ID=cirt-cm-01

# Persistance
CIRT_DB_PATH=./data/cirtdefense.db

# --- POSTURE D'AUTONOMIE (CDCF v3.0 - EF-07) -------------------------------
# true  : le moteur execute les actions correctives sans validation humaine
# false : mode observation, les actions sont planifiees mais jamais executees
CIRT_AUTONOMY_ENABLED=true

# Mode d'actionnement des connecteurs :
#   simulation = aucun effet reel (soutenance / recette)
#   live       = les actuateurs agissent sur les equipements
CIRT_ACTUATION_MODE=simulation

# --- EF-25 : boucle de controle fermee (rollback autonome) -----------------
CIRT_POST_ACTION_WATCH_SECONDS=120
CIRT_ROLLBACK_MAX_LATENCY_SECONDS=180

# --- EF-26 : coupe-circuit global ------------------------------------------
CIRT_CIRCUIT_BREAKER_ENABLED=true
# Nombre de rollbacks automatiques dans la fenetre avant declenchement
CIRT_BREAKER_ROLLBACK_THRESHOLD=3
CIRT_BREAKER_WINDOW_SECONDS=600
CIRT_BREAKER_ERROR_THRESHOLD=5

# --- Enrichissement RAG (EF-03 / EF-04) ------------------------------------
CIRT_KNOWLEDGE_DIR=src/cirtdefense/enrichment/knowledge
# Score minimal de recouvrement documentaire sous lequel le contexte est
# declare non fonde (EF-04 : interdiction d'agir sur un contexte halluciner)
CIRT_GROUNDING_MIN_SCORE=0.15

# --- Fournisseur LLM (optionnel : sans cle, le repli deterministe s'applique)
CIRT_LLM_PROVIDER=offline
ANTHROPIC_API_KEY=
CIRT_LLM_MODEL=claude-opus-5

# --- Mode degrade (Axe 5) ---------------------------------------------------
CIRT_DEGRADED_SPOOL=./data/spool
CIRT_DEGRADED_MAX_ITEMS=10000

# API
CIRT_API_HOST=0.0.0.0
CIRT_API_PORT=8000
CIRT_ADMIN_TOKEN=change-me-admin
CIRT_ANALYST_TOKEN=change-me-analyst
